def matrix_chain(p):
    n = len(p) - 1

    # dp[i][j] = minimum cost to multiply Ai...Aj
    dp = [[0 for _ in range(n)] for _ in range(n)]

    # length = number of matrices in the chain
    for length in range(2, n + 1):

        for i in range(n - length + 1):
            j = i + length - 1

            dp[i][j] = float('inf')

            # Try every possible split
            for k in range(i, j):

                cost = (
                    dp[i][k]
                    + dp[k + 1][j]
                    + p[i] * p[k + 1] * p[j + 1]
                )

                dp[i][j] = min(dp[i][j], cost)

    return dp


# Matrix dimensions
p = [10, 30, 5, 60]

dp = matrix_chain(p)

print("DP Matrix:")

for row in dp:
    print(row)

print("Minimum number of multiplications:", dp[0][len(p) - 2])







